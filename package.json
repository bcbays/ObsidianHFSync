{
	"name": "obsidian-hf-sync",
	"version": "0.3.0",
	"description": "Sync your Obsidian vault with a git remote (pull, commit, push) with a single click.",
	"main": "dist/hf-sync/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major"
	},
	"keywords": [],
	"author": "Blake C. Bays",
	"license": "MIT",
	"engines": {
		"node": ">=26"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.2",
		"obsidian": "latest",
		"tslib": "2.9.1",
		"typescript": "7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
